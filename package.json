{
  "name": "movimiento-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "images": "node scripts/images.mjs",
    "predev": "npm run images",
    "dev": "vite",
    "prebuild": "npm run images",
    "build": "tsc -b && vite build",
    "preview:cf": "npm run build && bash scripts/dev-setup.sh && wrangler pages dev dist --port 8788",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "extract-text": "node scripts/extract-text.mjs",
    "hooks": "git config core.hooksPath scripts/hooks"
  },
  "dependencies": {
    "@fontsource/libre-bodoni": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250101.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^20.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "pdfjs-dist": "^4.10.38",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^4.0.0",
    "wrangler": "4.86.0"
  }
}
